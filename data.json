    // State Variables
    let currentSymptoms = [...dataset];
    let selectedSymptom = null;
    let selectedCategory = 'All';
    let searchQuery = '';

    // Initialize Application
    window.onload = function() {
      // Try loading external data.json, fallback to embedded dataset on error
      fetch('data.json')
        .then(res => {
          if (!res.ok) throw new Error("Fallback to inline dataset");
          return res.json();
        })
        .then(data => {
          currentSymptoms = data;
          initApp();
        })
        .catch(() => {
          console.log("Using built-in dataset.");
          initApp();
        });
    };

    function initApp() {
      renderProBadge();
      filterAndRenderSymptoms();
      
      // Auto-select first item if available
      if (currentSymptoms.length > 0) {
        selectSymptom(currentSymptoms[0].id);
      }
    }

    function renderProBadge() {
      const isPro = localStorage.getItem('nutrimatch_pro') === 'true';
      const container = document.getElementById('pro-badge-container');
      
      if (isPro) {
        container.innerHTML = `
          <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1.5 rounded-full flex items-center gap-1.5">
            <span>✨</span> Member Access Unlocked
          </span>
          <button onclick="resetAccess()" class="text-xs text-slate-400 hover:text-slate-600 underline">Lock</button>
        `;
      } else {
        container.innerHTML = `
          <button onclick="unlockPro()" class="bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold px-4 py-2 rounded-xl transition shadow-xs flex items-center gap-1.5">
            <span>🔓</span> Unlock Full Access ($4.99/mo)
          </button>
        `;
      }
    }

    function handleSearch() {
      searchQuery = document.getElementById('search-input').value.toLowerCase().trim();
      filterAndRenderSymptoms();
    }

    function filterCategory(cat) {
      selectedCategory = cat;
      
      // Update Tab Styles
      document.querySelectorAll('.cat-btn').forEach(btn => {
        if (btn.innerText.includes(cat) || (cat === 'All' && btn.innerText.includes('All'))) {
          btn.className = "cat-btn active border px-3.5 py-1.5 rounded-full text-xs font-semibold transition bg-emerald-700 text-white border-emerald-700";
        } else {
          btn.className = "cat-btn border px-3.5 py-1.5 rounded-full text-xs font-semibold transition bg-slate-100 text-slate-700 border-slate-200 hover:border-emerald-500";
        }
      });

      filterAndRenderSymptoms();
    }

    function filterAndRenderSymptoms() {
      const filtered = dataset.filter(item => {
        const matchesCategory = (selectedCategory === 'All') || (item.category === selectedCategory);
        const matchesSearch = item.symptom.toLowerCase().includes(searchQuery) || 
                              item.summary.toLowerCase().includes(searchQuery) ||
                              item.nutrients.some(n => n.name.toLowerCase().includes(searchQuery) || n.foods.some(f => f.toLowerCase().includes(searchQuery)));
        return matchesCategory && matchesSearch;
      });

      const listContainer = document.getElementById('symptom-list');
      const countLabel = document.getElementById('symptom-count');
      const isPro = localStorage.getItem('nutrimatch_pro') === 'true';

      countLabel.innerText = `${filtered.length} items`;
      listContainer.innerHTML = '';

      if (filtered.length === 0) {
        listContainer.innerHTML = `<p class="text-xs text-slate-400 text-center py-6 italic">No matching symptoms found.</p>`;
        return;
      }

      filtered.forEach(item => {
        const isSelected = selectedSymptom && selectedSymptom.id === item.id;
        const isLocked = item.is_premium && !isPro;

        const btn = document.createElement('button');
        btn.className = `w-full text-left p-3.5 rounded-xl border transition flex flex-col gap-1 ${
          isSelected 
            ? 'bg-emerald-50 border-emerald-600 ring-1 ring-emerald-600' 
            : 'bg-white border-slate-200/80 hover:border-emerald-300 hover:bg-slate-50/80'
        }`;
        
        btn.onclick = () => selectSymptom(item.id);

        btn.innerHTML = `
          <div class="flex justify-between items-center w-full">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">${item.category}</span>
            ${isLocked 
              ? '<span class="bg-amber-100 text-amber-700 text-[10px] font-bold px-2 py-0.5 rounded-md">🔒 PRO</span>' 
              : '<span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded-md">FREE</span>'
            }
          </div>
          <span class="font-bold text-slate-900 text-sm">${item.symptom}</span>
        `;

        listContainer.appendChild(btn);
      });
    }

    function selectSymptom(id) {
      selectedSymptom = dataset.find(item => item.id === id);
      filterAndRenderSymptoms(); // Refresh sidebar active highlighting
      renderDetailView();
    }

    function renderDetailView() {
      const container = document.getElementById('detail-view');
      const isPro = localStorage.getItem('nutrimatch_pro') === 'true';

      if (!selectedSymptom) return;

      const item = selectedSymptom;
      const isLocked = item.is_premium && !isPro;

      // Locked Paywall Card
      if (isLocked) {
        container.innerHTML = `
          <div class="bg-gradient-to-b from-amber-50 to-white border border-amber-200/80 p-8 rounded-2xl text-center shadow-xs">
            <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center text-xl mx-auto mb-3">🔒</div>
            <span class="text-xs uppercase tracking-widest font-bold text-amber-700">Member Premium Guide</span>
            <h3 class="text-2xl font-black text-slate-900 mt-2">${item.symptom}</h3>
            <p class="text-slate-600 text-sm my-4 max-w-md mx-auto leading-relaxed">${item.summary}</p>
            
            <div class="bg-white p-5 rounded-xl border border-amber-200/60 max-w-md mx-auto mb-6 text-left space-y-2">
              <span class="text-xs font-bold text-slate-700 uppercase">What's locked inside:</span>
              <ul class="text-xs text-slate-600 space-y-1.5">
                <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Essential vitamin & mineral daily target breakdown</li>
                <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Top whole-food sources & absorption pro-tips</li>
                <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Herbal remedies, adaptogens & preparation guide</li>
              </ul>
            </div>

            <button onclick="unlockPro()" class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-8 py-3.5 rounded-xl shadow-md transition transform hover:-translate-y-0.5 text-sm">
              Unlock All Symptoms for $4.99/mo
            </button>
            <p class="text-xs text-slate-400 mt-3">Instant access • Cancel anytime</p>
          </div>
        `;
        return;
      }

      // Unlocked Full Detail View
      let html = `
        <div class="flex flex-wrap items-center justify-between gap-2 pb-4 mb-6 border-b border-slate-100">
          <div>
            <span class="text-xs uppercase tracking-widest font-extrabold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-100">${item.category}</span>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mt-2">${item.symptom}</h2>
          </div>
        </div>
        <p class="text-slate-600 text-sm leading-relaxed mb-8 bg-slate-50 p-4 rounded-xl border border-slate-100">${item.summary}</p>

        <!-- Essential Nutrients Section -->
        <div class="mb-8">
          <h3 class="font-bold text-slate-900 text-lg mb-4 flex items-center gap-2">
            <span>💊</span> Essential Nutrients Needed
          </h3>
          <div class="space-y-4">
      `;

      item.nutrients.forEach(n => {
        html += `
          <div class="p-5 rounded-xl bg-slate-50/80 border border-slate-200/80">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
              <h4 class="font-bold text-emerald-800 text-base">${n.name} <span class="text-xs font-normal text-slate-500">(${n.type})</span></h4>
              <span class="text-xs font-semibold bg-white border border-slate-200 px-2.5 py-1 rounded-full text-slate-600 w-fit">${n.daily_target}</span>
            </div>
            <p class="text-xs text-slate-600 mb-3 leading-relaxed">${n.role}</p>
            
            <div class="mb-3">
              <span class="text-xs font-bold text-slate-700 uppercase tracking-wider block mb-1.5">Top Whole Food Sources:</span>
              <div class="flex flex-wrap gap-2">
                ${n.foods.map(f => `<span class="bg-white border border-slate-200 text-slate-800 text-xs px-3 py-1 rounded-lg font-medium shadow-2xs">${f}</span>`).join('')}
              </div>
            </div>

            <div class="text-xs text-emerald-900 bg-emerald-100/70 border border-emerald-200/60 p-3 rounded-lg flex items-start gap-2">
              <span class="font-bold text-emerald-800">💡 Pro-Tip:</span>
              <span>${n.pro_tip}</span>
            </div>
          </div>
        `;
      });

      html += `
          </div>
        </div>
      `;

      // Herbal & Holistic Section
      if (item.herbs && item.herbs.length > 0) {
        html += `
          <div>
            <h3 class="font-bold text-slate-900 text-lg mb-4 flex items-center gap-2">
              <span>🌿</span> Herbal Remedies & Holistic Approaches
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        `;

        item.herbs.forEach(h => {
          html += `
            <div class="p-5 rounded-xl bg-emerald-50/40 border border-emerald-100 flex flex-col justify-between">
              <div>
                <div class="mb-2">
                  <h4 class="font-bold text-slate-900 text-base">${h.name}</h4>
                  <span class="text-xs text-emerald-700 font-medium">${h.type}</span>
                </div>
                <p class="text-xs text-slate-600 leading-relaxed mb-4">${h.benefit}</p>
              </div>
              <div class="bg-white p-3 rounded-lg border border-emerald-200/60 text-xs text-slate-700">
                <strong class="text-emerald-800 block mb-0.5">How to prepare:</strong>
                ${h.how_to_use}
              </div>
            </div>
          `;
        });

        html += `
            </div>
          </div>
        `;
      }

      container.innerHTML = html;
    }

    function unlockPro() {
      localStorage.setItem('nutrimatch_pro', 'true');
      renderProBadge();
      filterAndRenderSymptoms();
      if (selectedSymptom) renderDetailView();
    }

    function resetAccess() {
      localStorage.removeItem('nutrimatch_pro');
      renderProBadge();
      filterAndRenderSymptoms();
      if (selectedSymptom) renderDetailView();
    }
  </script>
</body>
</html>