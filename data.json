        <button onclick="filterCategory('Energy')" class="cat-btn border px-3.5 py-1.5 rounded-full text-xs font-semibold transition bg-slate-100 text-slate-700 border-slate-200 hover:border-emerald-500">Energy</button>
        <button onclick="filterCategory('Musculoskeletal')" class="cat-btn border px-3.5 py-1.5 rounded-full text-xs font-semibold transition bg-slate-100 text-slate-700 border-slate-200 hover:border-emerald-500">Musculoskeletal</button>
        <button onclick="filterCategory('Immune System')" class="cat-btn border px-3.5 py-1.5 rounded-full text-xs font-semibold transition bg-slate-100 text-slate-700 border-slate-200 hover:border-emerald-500">Immune</button>
        <button onclick="filterCategory('Gut & Brain')" class="cat-btn border px-3.5 py-1.5 rounded-full text-xs font-semibold transition bg-slate-100 text-slate-700 border-slate-200 hover:border-emerald-500">Gut & Brain</button>
        <button onclick="filterCategory('Nervous System')" class="cat-btn border px-3.5 py-1.5 rounded-full text-xs font-semibold transition bg-slate-100 text-slate-700 border-slate-200 hover:border-emerald-500">Nervous System</button>
        <button onclick="filterCategory('Appearance')" class="cat-btn border px-3.5 py-1.5 rounded-full text-xs font-semibold transition bg-slate-100 text-slate-700 border-slate-200 hover:border-emerald-500">Appearance</button>
